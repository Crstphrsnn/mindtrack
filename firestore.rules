rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // COMMON HELPERS
    // =====================================================
    function signedIn() {
      return request.auth != null;
    }

    function hasInstitutionalEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@psu[.]edu[.]ph$');
    }

    function hasVerifiedInstitutionalEmail() {
      return hasInstitutionalEmail()
        && request.auth.token.email_verified == true;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function targetUser(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data;
    }

    function isSuperAdmin() {
      return signedIn()
        && profile().role == "super_admin";
    }

    function isCounselor() {
      return signedIn()
        && profile().role == "counselor";
    }

    function isGeneralUserRole(role) {
      return role == "student"
        || role == "teaching"
        || role == "non_teaching"
        || role == "faculty"
        || role == "personnel";
    }

    function isReferralUserRole(role) {
      return role == "teaching"
        || role == "non_teaching"
        || role == "faculty"
        || role == "personnel";
    }

    function isValidReferralStatus(status) {
      return status == "Received"
        || status == "Contacted"
        || status == "Completed";
    }

    function sameDepartment(department) {
      return isCounselor()
        && profile().department == department;
    }

    function counselingProfileExists(userId) {
      return exists(
        /databases/$(database)/documents/counselingProfiles/$(userId)
      );
    }

    function isAssignedCounselor(userId) {
      return isCounselor()
        && counselingProfileExists(userId)
        && get(
          /databases/$(database)/documents/counselingProfiles/$(userId)
        ).data.assignedCounselorId == request.auth.uid;
    }

    function wasPreviousCounselor(userId) {
      return isCounselor()
        && counselingProfileExists(userId)
        && "previousCounselorIds" in get(
          /databases/$(database)/documents/counselingProfiles/$(userId)
        ).data
        && request.auth.uid in get(
          /databases/$(database)/documents/counselingProfiles/$(userId)
        ).data.previousCounselorIds;
    }

    function canCounselUser(userId, department) {
      return isCounselor()
        && (
          profile().department == department
          || isAssignedCounselor(userId)
        );
    }

    function isValidPriority(priority) {
      return priority == "Low"
        || priority == "Moderate"
        || priority == "High"
        || priority == "Critical";
    }

    function isValidFeedbackCategory(category) {
      return category == "Overall Experience"
        || category == "Ease of Use"
        || category == "System Performance"
        || category == "Assessment"
        || category == "Counseling"
        || category == "Privacy and Security"
        || category == "Interface / Design"
        || category == "Other";
    }


    // =====================================================
    // USERS
    // =====================================================
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || (
          isCounselor() && (
            resource.data.department == profile().department
            || resource.data.role == "counselor"
            || isAssignedCounselor(userId)
            || wasPreviousCounselor(userId)
          )
        )
      );

      // Registration happens before email verification is completed,
      // therefore an institutional email is required but verified=true
      // is intentionally not required here.
      allow create: if hasInstitutionalEmail()
        && request.auth.uid == userId
        && request.resource.data.id == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && isGeneralUserRole(request.resource.data.role);

      // Public identity / routing information is intentionally read-only.
      // Editable contact information lives in userPrivateProfiles.
      allow update: if false;

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // PRIVATE USER PROFILES
    // =====================================================
    match /userPrivateProfiles/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || isAssignedCounselor(userId)
      );

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "phoneNumber",
          "address",
          "facebookAccount",
          "contactPersonName",
          "contactPersonPhone",
          "updatedAt"
        ]);

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // COUNSELOR DIRECTORY
    // =====================================================
    match /counselorDirectory/{counselorId} {
      // Registration needs the active counselor directory before a user
      // account exists. This collection must contain directory/routing data
      // only, never private counseling information.
      allow read: if true;

      allow create, update, delete: if isSuperAdmin();
    }


    // =====================================================
    // ASSESSMENT LOCKS
    // =====================================================
    match /assessmentLocks/{userId} {
      allow create: if (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.ownerId == request.auth.uid
        )
        || isSuperAdmin();

      // ownerId is included so ownerId collection queries are provable by
      // Firestore rules; document-id-only authorization is not enough for
      // where("ownerId", "==", uid) queries.
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.auth.uid == userId
        || isSuperAdmin()
        || canCounselUser(resource.data.ownerId, resource.data.department)
      );

      // General user: update only their own eligibility state as part of a
      // transaction that creates/uses their own assessment.
      allow update: if hasVerifiedInstitutionalEmail()
        && request.auth.uid == userId
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "latestAssessmentId",
          "status",
          "concludedAt",
          "earlyReassessmentAllowed",
          "updatedAt"
        ])
        && (
          request.resource.data.latestAssessmentId == ""
          || getAfter(
            /databases/$(database)/documents/assessments/$(request.resource.data.latestAssessmentId)
          ).data.ownerId == request.auth.uid
        );

      // Counselor / Super Admin maintain review lifecycle state.
      allow update: if isSuperAdmin()
        || (
          canCounselUser(resource.data.ownerId, resource.data.department)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.department == resource.data.department
        );

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // ASSESSMENT USER VIEWS
    // Summary-only records shown to the account owner.
    // =====================================================
    match /assessmentUserViews/{assessmentId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || isSuperAdmin()
        || canCounselUser(resource.data.ownerId, resource.data.department)
      );

      allow create: if hasVerifiedInstitutionalEmail()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.assessmentId == assessmentId;

      // Counselors update the user's summary when reviewing an assessment.
      // Super Admin may repair the summary when deleting/repairing records.
      allow create, update: if isSuperAdmin()
        || (
          canCounselUser(
            request.resource.data.ownerId,
            request.resource.data.department
          )
          && request.resource.data.assessmentId == assessmentId
        );

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // ASSESSMENTS
    // =====================================================
    match /assessments/{assessmentId} {
      allow create: if hasVerifiedInstitutionalEmail()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName == profile().name
        && request.resource.data.role == profile().role
        && request.resource.data.department == profile().department
        && request.resource.data.status == "For review"
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && isValidPriority(request.resource.data.priority);

      allow read: if signedIn() && (
        (
          resource.data.ownerId == request.auth.uid
          && hasVerifiedInstitutionalEmail()
        )
        || isSuperAdmin()
        || canCounselUser(resource.data.ownerId, resource.data.department)
      );

      // Submitted answers/scores stay immutable to the general user.
      // Counselor and Super Admin may change review metadata only.
      allow update: if isSuperAdmin()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department;

      allow update: if canCounselUser(
          resource.data.ownerId,
          resource.data.department
        )
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "counselorRemarks",
          "status",
          "reviewed",
          "reviewedById",
          "reviewedByName",
          "reviewedByRole",
          "updatedAt"
        ]);

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // COUNSELING REQUEST LOCKS
    // =====================================================
    match /counselingRequestLocks/{userId} {
      allow create: if (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.ownerId == request.auth.uid
        )
        || isSuperAdmin();

      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.auth.uid == userId
        || isSuperAdmin()
        || canCounselUser(resource.data.ownerId, resource.data.department)
      );

      // User changes the lock only while creating a request owned by them.
      allow update: if hasVerifiedInstitutionalEmail()
        && request.auth.uid == userId
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "latestConsultationId",
          "status",
          "updatedAt"
        ])
        && (
          request.resource.data.latestConsultationId == ""
          || getAfter(
            /databases/$(database)/documents/consultations/$(request.resource.data.latestConsultationId)
          ).data.ownerId == request.auth.uid
        );

      allow update: if isSuperAdmin()
        || (
          canCounselUser(resource.data.ownerId, resource.data.department)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.department == resource.data.department
        );

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // CONSULTATIONS / COUNSELING REQUESTS
    // =====================================================
    match /consultations/{consultationId} {
      allow create: if hasVerifiedInstitutionalEmail()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName == profile().name
        && request.resource.data.department == profile().department
        && request.resource.data.status == "Pending approval"
        && request.resource.data.source == "Self-request";

      allow read: if signedIn() && (
        (
          resource.data.ownerId == request.auth.uid
          && hasVerifiedInstitutionalEmail()
        )
        || isSuperAdmin()
        || sameDepartment(resource.data.department)
        || (
          isCounselor()
          && resource.data.assignedCounselorId == request.auth.uid
        )
        || (
          // The specifically selected receiving counselor must be able to
          // read the pending consultation before a Firestore transaction can
          // approve the transfer. Access is limited to the one consultation
          // linked to the active pending transfer request.
          isCounselor()
          && resource.data.transferStatus == "Pending approval"
          && resource.data.transferRequestId is string
          && exists(
            /databases/$(database)/documents/transferRequests/$(resource.data.transferRequestId)
          )
          && get(
            /databases/$(database)/documents/transferRequests/$(resource.data.transferRequestId)
          ).data.status == "Pending approval"
          && get(
            /databases/$(database)/documents/transferRequests/$(resource.data.transferRequestId)
          ).data.targetCounselorId == request.auth.uid
          && get(
            /databases/$(database)/documents/transferRequests/$(resource.data.transferRequestId)
          ).data.consultationId == consultationId
          && get(
            /databases/$(database)/documents/transferRequests/$(resource.data.transferRequestId)
          ).data.ownerId == resource.data.ownerId
        )
      );

      // User may edit only their own pending request details.
      allow update: if hasVerifiedInstitutionalEmail()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department
        && request.resource.data.status == "Pending approval"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "mode",
          "date",
          "time",
          "category",
          "message",
          "status",
          "updatedAt"
        ]);

      // Current/home counselor may review and schedule. Include sessionNumber
      // because the current App assigns it on the first accepted session.
      allow update: if isCounselor()
        && (
          resource.data.assignedCounselorId == request.auth.uid
          || (
            (!("assignedCounselorId" in resource.data)
              || resource.data.assignedCounselorId == "")
            && resource.data.department == profile().department
          )
        )
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department
        && (
          resource.data.status != "Terminated"
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "transferStatus",
            "transferRequestId"
          ])
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "counselorRemarks",
          "assignedCounselorId",
          "assignedCounselorName",
          "assignedCounselorDepartment",
          "sessionNumber",
          "transferStatus",
          "transferRequestId",
          "updatedAt"
        ]);

      // The specifically targeted counselor may accept an approved transfer
      // in the same transaction and become the new assigned counselor.
      allow update: if isCounselor()
        && resource.data.status != "Terminated"
        && request.resource.data.transferRequestId is string
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
        ).data.status == "Approved"
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
        ).data.acceptedById == request.auth.uid
        && request.resource.data.assignedCounselorId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "assignedCounselorId",
          "assignedCounselorName",
          "assignedCounselorDepartment",
          "transferStatus",
          "transferRequestId",
          "transferredFromCounselorId",
          "transferredFromCounselorName",
          "transferredAt",
          "updatedAt"
        ]);

      // The selected receiving counselor may cancel a pending transfer.
      // Only transfer markers are cleared; the current counselor assignment
      // remains unchanged.
      allow update: if isCounselor()
        && resource.data.transferStatus == "Pending approval"
        && resource.data.transferRequestId is string
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(resource.data.transferRequestId)
        ).data.status == "Cancelled"
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(resource.data.transferRequestId)
        ).data.targetCounselorId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(resource.data.transferRequestId)
        ).data.cancelledById == request.auth.uid
        && request.resource.data.assignedCounselorId == resource.data.assignedCounselorId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department
        && request.resource.data.transferStatus == ""
        && request.resource.data.transferRequestId == ""
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "transferStatus",
          "transferRequestId",
          "updatedAt"
        ]);

      // Super Admin performs cleanup/session renumbering and may repair
      // operational metadata, but ownership stays fixed.
      allow update: if isSuperAdmin()
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // COUNSELING SCHEDULE SLOTS
    // =====================================================
    match /counselingScheduleSlots/{slotId} {
      function validSlotTime(value) {
        return value in [
          "8:00 AM", "9:00 AM", "10:00 AM", "11:00 AM",
          "1:00 PM", "2:00 PM", "3:00 PM", "4:00 PM"
        ];
      }

      function validSlotState(value) {
        return value in ["held", "booked"];
      }

      function slotIdMatches(data) {
        return slotId == data.counselorId + "__" + data.date + "__" + data.time;
      }

      function validSlotKeys(data) {
        return data.keys().hasOnly([
          "counselorId",
          "date",
          "time",
          "consultationId",
          "assignmentSourceConsultationId",
          "state",
          "createdAt",
          "updatedAt"
        ]);
      }

      // General users need occupancy only; counselors need their calendar.
      allow read: if hasVerifiedInstitutionalEmail()
        || isCounselor()
        || isSuperAdmin();

      // General-user slot hold. getAfter is used for BOTH consultation
      // references so the first-ever counseling request can create its
      // consultation and slot atomically in one transaction.
      allow create, update: if hasVerifiedInstitutionalEmail()
        && validSlotKeys(request.resource.data)
        && slotIdMatches(request.resource.data)
        && validSlotTime(request.resource.data.time)
        && request.resource.data.state == "held"
        && request.resource.data.consultationId is string
        && request.resource.data.assignmentSourceConsultationId is string
        && getAfter(
          /databases/$(database)/documents/consultations/$(request.resource.data.consultationId)
        ).data.ownerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/consultations/$(request.resource.data.assignmentSourceConsultationId)
        ).data.ownerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/consultations/$(request.resource.data.assignmentSourceConsultationId)
        ).data.assignedCounselorId == request.resource.data.counselorId;

      // Counselor may hold/book only a slot assigned to themselves.
      allow create, update: if isCounselor()
        && request.resource.data.counselorId == request.auth.uid
        && validSlotKeys(request.resource.data)
        && slotIdMatches(request.resource.data)
        && validSlotTime(request.resource.data.time)
        && validSlotState(request.resource.data.state);

      allow create, update: if isSuperAdmin();

      allow delete: if isSuperAdmin()
        || (
          hasVerifiedInstitutionalEmail()
          && get(
            /databases/$(database)/documents/consultations/$(resource.data.consultationId)
          ).data.ownerId == request.auth.uid
        )
        || (
          isCounselor()
          && (
            resource.data.counselorId == request.auth.uid
            || getAfter(
              /databases/$(database)/documents/consultations/$(resource.data.consultationId)
            ).data.assignedCounselorId == request.auth.uid
          )
        );
    }


    // =====================================================
    // COUNSELING PROFILES / CASE OWNERSHIP
    // =====================================================
    match /counselingProfiles/{userId} {
      allow read: if isSuperAdmin()
        || (
          isCounselor() && (
            // IMPORTANT: use resource.data directly so Firestore can
            // authorize collection queries such as:
            // where("assignedCounselorId", "==", request.auth.uid)
            (
              "assignedCounselorId" in resource.data
              && resource.data.assignedCounselorId == request.auth.uid
            )
            || (
              "department" in resource.data
              && resource.data.department == profile().department
            )
            || (
              "previousCounselorIds" in resource.data
              && request.auth.uid in resource.data.previousCounselorIds
            )
            || (
              "profileTransferStatus" in resource.data
              && resource.data.profileTransferStatus == "Pending approval"
              && "profileTransferRequestId" in resource.data
              && resource.data.profileTransferRequestId is string
              && exists(
                /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
              )
              && get(
                /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
              ).data.status == "Pending approval"
              && get(
                /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
              ).data.targetCounselorId == request.auth.uid
              && get(
                /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
              ).data.ownerId == userId
            )
          )
        );

      // Same-department counselor may create the case profile and become
      // its initial assigned counselor.
      allow create: if (
          isCounselor()
          && targetUser(userId).department == profile().department
          && request.resource.data.ownerId == userId
          && request.resource.data.department == targetUser(userId).department
          && request.resource.data.assignedCounselorId == request.auth.uid
        )
        || (
          isCounselor()
          && request.resource.data.transferRequestId is string
          && getAfter(
            /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
          ).data.status == "Approved"
          && getAfter(
            /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
          ).data.acceptedById == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
          ).data.ownerId == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.assignedCounselorId == request.auth.uid
        );

      // Current assigned counselor may maintain case/session metadata.
      allow update: if isCounselor()
        && resource.data.assignedCounselorId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department;

      // Unassigned same-department profile may be claimed once.
      allow update: if isCounselor()
        && resource.data.department == profile().department
        && (
          !("assignedCounselorId" in resource.data)
          || resource.data.assignedCounselorId == ""
        )
        && request.resource.data.assignedCounselorId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department;

      // New counselor may take ownership only through the approved transfer.
      allow update: if isCounselor()
        && request.resource.data.transferRequestId is string
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
        ).data.status == "Approved"
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
        ).data.acceptedById == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
        ).data.ownerId == userId
        && request.resource.data.ownerId == userId
        && request.resource.data.assignedCounselorId == request.auth.uid;

      // The selected counselor may reject a profile-only transfer.
      // The current assignment is preserved and only pending-transfer markers
      // are cleared after the linked transfer request becomes Cancelled.
      allow update: if isCounselor()
        && resource.data.profileTransferStatus == "Pending approval"
        && resource.data.profileTransferRequestId is string
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
        ).data.status == "Cancelled"
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
        ).data.targetCounselorId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
        ).data.cancelledById == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.department == resource.data.department
        && request.resource.data.profileTransferStatus == ""
        && request.resource.data.profileTransferRequestId == ""
        && (
          (
            getAfter(
              /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
            ).data.requesterWasAssigned == true
            && request.resource.data.assignedCounselorId == resource.data.assignedCounselorId
            && request.resource.data.assignedCounselorName == resource.data.assignedCounselorName
            && request.resource.data.assignedCounselorDepartment == resource.data.assignedCounselorDepartment
          )
          ||
          (
            getAfter(
              /databases/$(database)/documents/transferRequests/$(resource.data.profileTransferRequestId)
            ).data.requesterWasAssigned == false
            && request.resource.data.assignedCounselorId == ""
            && request.resource.data.assignedCounselorName == ""
            && request.resource.data.assignedCounselorDepartment == ""
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "assignedCounselorId",
          "assignedCounselorName",
          "assignedCounselorDepartment",
          "profileTransferStatus",
          "profileTransferRequestId",
          "updatedAt"
        ]);

      allow update: if isSuperAdmin()
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // PRIVATE COUNSELING SESSION NOTES
    // One note document per consultation ID.
    // =====================================================
    match /counselingSessionNotes/{consultationId} {
      allow read: if isSuperAdmin()
        || (
          isCounselor()
          && (
            get(
              /databases/$(database)/documents/consultations/$(consultationId)
            ).data.department == profile().department
            || get(
              /databases/$(database)/documents/consultations/$(consultationId)
            ).data.assignedCounselorId == request.auth.uid
          )
        );

      allow create, update: if isSuperAdmin()
        || (
          isCounselor()
          && get(
            /databases/$(database)/documents/consultations/$(consultationId)
          ).data.assignedCounselorId == request.auth.uid
          && request.resource.data.consultationId == consultationId
          && request.resource.data.ownerId == get(
            /databases/$(database)/documents/consultations/$(consultationId)
          ).data.ownerId
        );

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // COUNSELOR TRANSFER REQUESTS
    // =====================================================
    match /transferRequests/{transferId} {
      allow read: if isCounselor() || isSuperAdmin();

      allow create: if isCounselor()
        && request.resource.data.requestedById == request.auth.uid
        && request.resource.data.requestedByName == profile().name
        && request.resource.data.requestedByDepartment == profile().department
        && request.resource.data.status == "Pending approval"
        && request.resource.data.targetCounselorId is string
        && request.resource.data.targetCounselorId != request.auth.uid
        && request.resource.data.ownerId is string
        && request.resource.data.consultationId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && !wasPreviousCounselor(request.resource.data.ownerId)
        && (
          !counselingProfileExists(request.resource.data.ownerId)
          || !(
            "previousCounselorIds" in get(
              /databases/$(database)/documents/counselingProfiles/$(request.resource.data.ownerId)
            ).data
          )
          || !(
            request.resource.data.targetCounselorId in get(
              /databases/$(database)/documents/counselingProfiles/$(request.resource.data.ownerId)
            ).data.previousCounselorIds
          )
        )
        && (
          (
            request.resource.data.sourceType == "consultation"
            && request.resource.data.consultationId.size() > 0
            && get(
              /databases/$(database)/documents/consultations/$(request.resource.data.consultationId)
            ).data.ownerId == request.resource.data.ownerId
            && get(
              /databases/$(database)/documents/consultations/$(request.resource.data.consultationId)
            ).data.assignedCounselorId == request.auth.uid
            && get(
              /databases/$(database)/documents/consultations/$(request.resource.data.consultationId)
            ).data.status != "Terminated"
            && request.resource.data.consultationStatus == get(
              /databases/$(database)/documents/consultations/$(request.resource.data.consultationId)
            ).data.status
          )
          ||
          (
            request.resource.data.sourceType == "profile"
            && request.resource.data.requesterWasAssigned is bool
            && request.resource.data.consultationId == ""
            && getAfter(
              /databases/$(database)/documents/counselingProfiles/$(request.resource.data.ownerId)
            ).data.assignedCounselorId == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/counselingProfiles/$(request.resource.data.ownerId)
            ).data.profileTransferStatus == "Pending approval"
            && getAfter(
              /databases/$(database)/documents/counselingProfiles/$(request.resource.data.ownerId)
            ).data.profileTransferRequestId == transferId
          )
        );

      // The specifically targeted counselor may accept a pending transfer.
      allow update: if isCounselor()
        && resource.data.status == "Pending approval"
        && resource.data.targetCounselorId == request.auth.uid
        && resource.data.requestedById != request.auth.uid
        && request.resource.data.status == "Approved"
        && request.resource.data.acceptedById == request.auth.uid
        && request.resource.data.acceptedByName == profile().name
        && request.resource.data.acceptedByDepartment == profile().department
        && (
          resource.data.sourceType != "consultation"
          || (
            resource.data.consultationId is string
            && resource.data.consultationId.size() > 0
            && get(
              /databases/$(database)/documents/consultations/$(resource.data.consultationId)
            ).data.status != "Terminated"
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "acceptedById",
          "acceptedByName",
          "acceptedByDepartment",
          "approvedAt",
          "updatedAt"
        ]);

      // The selected receiving counselor may cancel/reject the pending
      // transfer before acceptance. A reason is required and the record is
      // preserved so the current counselor may transfer the user again later.
      allow update: if isCounselor()
        && resource.data.status == "Pending approval"
        && resource.data.targetCounselorId == request.auth.uid
        && resource.data.requestedById != request.auth.uid
        && request.resource.data.status == "Cancelled"
        && request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason.size() > 0
        && request.resource.data.cancellationReason.size() <= 1000
        && request.resource.data.cancelledById == request.auth.uid
        && request.resource.data.cancelledByName == profile().name
        && request.resource.data.cancelledByDepartment == profile().department
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "cancellationReason",
          "cancelledById",
          "cancelledByName",
          "cancelledByDepartment",
          "cancelledAt",
          "updatedAt"
        ]);

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // COUNSELOR TRANSFER ACCESS
    // =====================================================
    match /transferAccess/{accessId} {
      allow read: if isSuperAdmin()
        || (
          isCounselor() && (
            resource.data.counselorId == request.auth.uid
            || resource.data.previousCounselorId == request.auth.uid
          )
        );

      allow create, update: if isCounselor()
        && request.resource.data.counselorId == request.auth.uid
        && request.resource.data.transferRequestId is string
        && request.resource.data.active == true
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
        ).data.status == "Approved"
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
        ).data.acceptedById == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/transferRequests/$(request.resource.data.transferRequestId)
        ).data.ownerId == request.resource.data.ownerId;

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // REFERRALS
    // =====================================================
    match /referrals/{referralId} {
      allow create: if hasVerifiedInstitutionalEmail()
        && isReferralUserRole(profile().role)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.referrerId == request.auth.uid
        && request.resource.data.referrerName == profile().name
        && request.resource.data.referrerRole == profile().role
        && request.resource.data.assignedCounselorId is string
        && request.resource.data.status == "Received";

      allow read: if signedIn() && (
        (
          resource.data.ownerId == request.auth.uid
          && hasVerifiedInstitutionalEmail()
        )
        || isSuperAdmin()
        || (
          isCounselor()
          && resource.data.assignedCounselorId == request.auth.uid
        )
      );

      allow update: if isSuperAdmin();

      allow update: if isCounselor()
        && resource.data.assignedCounselorId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.assignedCounselorId == resource.data.assignedCounselorId
        && isValidReferralStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "counselorRemarks",
          "updatedById",
          "updatedByName",
          "updatedAt"
        ])
        && request.resource.data.updatedById == request.auth.uid;

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // PRIVATE REFERRAL COUNSELING NOTES
    // =====================================================
    // Stored separately from referrals so Teaching / Non-teaching
    // referrers cannot receive private counselor documentation.
    match /referralCounselingNotes/{referralId} {
      allow read: if isSuperAdmin()
        || (
          isCounselor()
          && exists(
            /databases/$(database)/documents/referrals/$(referralId)
          )
          && get(
            /databases/$(database)/documents/referrals/$(referralId)
          ).data.assignedCounselorId == request.auth.uid
        );

      allow create: if isCounselor()
        && request.resource.data.referralId == referralId
        && request.resource.data.assignedCounselorId == request.auth.uid
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.caseHistory is string
        && request.resource.data.counselingSessionSummary is string
        && request.resource.data.counselorObservation is string
        && request.resource.data.recommendations is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(
          /databases/$(database)/documents/referrals/$(referralId)
        )
        && get(
          /databases/$(database)/documents/referrals/$(referralId)
        ).data.assignedCounselorId == request.auth.uid;

      allow update: if isCounselor()
        && resource.data.assignedCounselorId == request.auth.uid
        && request.resource.data.referralId == referralId
        && request.resource.data.assignedCounselorId == resource.data.assignedCounselorId
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.caseHistory is string
        && request.resource.data.counselingSessionSummary is string
        && request.resource.data.counselorObservation is string
        && request.resource.data.recommendations is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "caseHistory",
          "counselingSessionSummary",
          "counselorObservation",
          "recommendations",
          "assignedCounselorName",
          "referredPersonName",
          "updatedById",
          "updatedByName",
          "updatedAt"
        ])
        && exists(
          /databases/$(database)/documents/referrals/$(referralId)
        )
        && get(
          /databases/$(database)/documents/referrals/$(referralId)
        ).data.assignedCounselorId == request.auth.uid;

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // RATINGS & FEEDBACK
    // =====================================================
    match /feedback/{feedbackId} {
      allow create: if hasVerifiedInstitutionalEmail()
        && isGeneralUserRole(profile().role)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName == profile().name
        && request.resource.data.role == profile().role
        && request.resource.data.department == profile().department
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.category is string
        && isValidFeedbackCategory(request.resource.data.category)
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 1000;

      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || isSuperAdmin()
      );

      allow update: if false;
      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // NOTIFICATIONS
    // =====================================================
    match /notifications/{notificationId} {
      // Owners can read their own notifications regardless of role.
      allow read: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || isSuperAdmin()
        );

      // Current UI creates system notifications from counselor actions.
      // Limit that ability to authenticated counselor identities and an
      // existing target user, but do not hard-code notification type names
      // so newer counselor workflows do not silently break the rules.
      allow create: if isCounselor()
        && request.resource.data.ownerId is string
        && request.resource.data.senderRole == "counselor"
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.read == false
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.ownerId)
        );

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "read",
          "updatedAt"
        ]);

      allow delete: if isSuperAdmin();
    }


    // =====================================================
    // DEFAULT DENY
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
